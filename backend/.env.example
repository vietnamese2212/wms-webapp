# ─── Supabase (required for runtime) ────────────────────────
# Lấy từ: Supabase Dashboard > Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─── Prisma (chỉ dùng local để migrate schema) ───────────────
# Lấy từ: Supabase Dashboard > Connect > ORMs > Prisma
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"

# ─── Server ──────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:5173"
