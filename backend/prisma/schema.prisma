// WMS Supply Chain – Prisma Schema
// Database: PostgreSQL (Supabase hoặc PostgreSQL gốc)
// generator client sẽ tạo @prisma/client để dùng trong code

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MASTERDATA – VỊ TRÍ KHO
// ============================================================

model Warehouse {
  id         String   @id @default(uuid())
  code       String   @unique  // "BV", "BB" – dùng làm prefix location_code
  name       String            // "Kho Ba Vì", "Kho Bàu Bàng"
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  locations          Location[]
  employees          Employee[]
  production_imports ProductionImport[]
}

// location_code tự động sinh: "{warehouse.code}_{sub_code}_{row}_{shelf}"
// VD: "BV_TP1_1_T1"
model Location {
  id            String    @id @default(uuid())
  warehouse_id  String
  warehouse     Warehouse @relation(fields: [warehouse_id], references: [id])
  sub_code      String              // "TP1", "NL1" – prefix kho nhỏ
  sub_name      String?             // "Thành phẩm 1", "Nguyên liệu 1"
  sub_type      String?             // "THANH_PHAM" | "NGUYEN_LIEU" | "BAN_THANH_PHAM"
  location_code String    @unique   // Auto-generated, không nhập tay
  row           String              // "1", "2", "3"
  shelf         String              // "T1", "T2" (tầng/kệ)
  max_pallets   Int       @default(1)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  inventory_entries  InventoryEntry[]
  production_imports ProductionImport[]

  @@index([warehouse_id])
  @@index([warehouse_id, sub_code])
}

// ============================================================
// MASTERDATA – HÀNG HOÁ
// ============================================================

// NMSX – Nhà máy sản xuất (ký hiệu chữ/số)
model Manufacturer {
  id         String   @id @default(uuid())
  code       String   @unique  // "A", "01", "NM3"
  name       String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  materials         Material[]
  inventory_entries InventoryEntry[]
}

model Material {
  id                    String        @id @default(uuid())
  material_code         String        @unique  // "510000127"
  material_description  String                 // "LOF Ba Vì Sữa tươi Có đường 180mlx48"
  // short_name = "{custom_short_name ?? material_description} [{last 3 digits}]"
  short_name            String?
  custom_short_name     String?                // User override tên, suffix [xxx] giữ nguyên
  category              String?                // Phân loại: "Thành phẩm", "NVL", "POSM", "Bao bì"...
  product_type          String?                // Loại: "180", "110", "200"...
  unit                  String?                // "thùng", "cái", "kg"
  weight_kg             Decimal?               // KG – trọng lượng 1 thùng (kg)
  cartons_per_pallet    Int?                   // Thùng/Pallet (Thành phẩm)
  cartons_per_pallet_mn Int?                   // Thùng/Pallet khu vực MN (Thành phẩm)
  units_per_carton      Int?                   // Hộp/Thùng
  ea_per_pallet         Int?                   // EA/Pallet (NVL) – tính pallet = tổng EA ÷ ea_per_pallet
  shelf_life_days       Int?                   // Shelf life (ngày)
  storage_category      String?                // KHO: "UHT", "Fresh", "Frozen"...
  old_code              String?                // Mã cũ (legacy)
  image_url             String?                // Hình ảnh sản phẩm
  manufacturer_id       String?
  manufacturer          Manufacturer? @relation(fields: [manufacturer_id], references: [id])
  notes                 String?
  is_active             Boolean       @default(true)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  inventory_entries  InventoryEntry[]
  export_history     ExportHistory[]
  production_imports ProductionImport[]
}

// ============================================================
// MASTERDATA – CA NHẬP & TÌNH TRẠNG QA
// ============================================================

model ImportShift {
  id            String   @id @default(uuid())
  code          String   @unique  // "CA1", "CA2", "CA3", "HC"
  name          String            // "Ca 1", "Ca 2", "Ca 3", "HC"
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  production_imports ProductionImport[]
}

model QAStatus {
  id            String   @id @default(uuid())
  code          String   @unique  // "X", "XCQ", "X7", "OK"
  name          String            // "X", "X cảm quan", "X 7", "OK"
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  inventory_entries InventoryEntry[]
}

// ============================================================
// MASTERDATA – NHÂN SỰ
// ============================================================

model Employee {
  id            String     @id @default(uuid())
  warehouse_id  String?
  warehouse     Warehouse? @relation(fields: [warehouse_id], references: [id])
  employee_code String?    @unique
  name          String
  role          String
  // "ADMIN" | "WAREHOUSE_MANAGER" | "WAREHOUSE_STAFF" | "DRIVER" | "HR_MANAGER"
  department    String?
  phone         String?
  email         String?    @unique
  password      String     // bcrypt hash
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  schedules          Schedule[]
  overtime_requests  OvertimeRequest[]
  attendances        Attendance[]
  location_transfers LocationTransfer[]
  export_history     ExportHistory[]

  // ProductionImport (phiếu nhập) relations – named to avoid ambiguity
  production_imports_imported  ProductionImport[] @relation("PIImportedBy")
  production_imports_created   ProductionImport[] @relation("PICreatedBy")
  production_imports_updated   ProductionImport[] @relation("PIUpdatedBy")

  // InventoryEntry audit relations
  inv_entries_created InventoryEntry[] @relation("IECreatedBy")
  inv_entries_updated InventoryEntry[] @relation("IEUpdatedBy")
}

// ============================================================
// MASTERDATA – XE & TÀI XẾ
// ============================================================

model Driver {
  id         String   @id @default(uuid())
  code       String?  @unique
  name       String
  phone      String?
  id_card    String?
  license_no String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Các xe mà driver này là tài xế mặc định
  default_for_vehicles Vehicle[]
  // Các chuyến giao hàng thực tế driver đã/đang lái
  delivery_orders      DeliveryOrder[]
}

model Vehicle {
  id                String    @id @default(uuid())
  plate_number      String    @unique  // "51C-12345"
  type              String?            // "Xe tải", "Xe container", "Xe bán tải"
  capacity_tons     Float?
  default_driver_id String?
  // Tài xế mặc định (hiển thị khi tạo lệnh vận chuyển, có thể ghi đè)
  default_driver    Driver?   @relation(fields: [default_driver_id], references: [id])
  next_inspection   DateTime?
  notes             String?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  delivery_orders   DeliveryOrder[]
}

// ============================================================
// WMS – QUẢN LÝ KHO
// ============================================================

model InventoryEntry {
  id              String        @id @default(uuid())
  pallet_code     String        @unique  // Mã QR dán trên pallet
  location_id     String?
  location        Location?     @relation(fields: [location_id], references: [id])
  material_id     String
  material        Material      @relation(fields: [material_id], references: [id])
  manufacturer_id String?
  manufacturer    Manufacturer? @relation(fields: [manufacturer_id], references: [id])

  // Chu kỳ sản xuất – bóc từ QR hoặc chọn tay (VD: "C05", "2025-05")
  cycle           String?
  // Máy sản xuất – bóc từ QR (VD: "M1", "M2")
  machine_code    String?

  // Liên kết phiếu nhập kho
  import_order_id String?
  import_order    ProductionImport? @relation(fields: [import_order_id], references: [id])

  // Audit trail
  created_by      String?
  created_by_emp  Employee? @relation("IECreatedBy", fields: [created_by], references: [id])
  updated_by      String?
  updated_by_emp  Employee? @relation("IEUpdatedBy", fields: [updated_by], references: [id])

  // Số thứ tự pallet – vị trí thứ 5 trong QR code (VD: 001 → 1)
  pallet_sequence_no Int?

  // Tình trạng QA
  qa_status_id    String?
  qa_status       QAStatus?    @relation(fields: [qa_status_id], references: [id])

  // Pallet stacking – thay thế bypass_location cũ:
  // stack_layer = 1 → pallet đặt sàn, tính vào max_pallets của Location
  // stack_layer = 2, 3 → chồng lên pallet khác, KHÔNG tính vào max_pallets
  stack_layer     Int           @default(1)

  cartons_imported Int
  production_date  DateTime?
  status           String       @default("IN_STOCK")
  // "IN_STOCK" | "EXPORTED" | "TRANSFERRED" | "PARTIAL"
  notes            String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  export_history     ExportHistory[]
  location_transfers LocationTransfer[]

  @@index([location_id, status])
  @@index([material_id])
  @@index([status])
  @@index([import_order_id])
}

// Phiếu nhập kho – bảng cha (header record)
model ProductionImport {
  id              String     @id @default(uuid())
  import_code     String?    @unique    // Auto-gen: "NK-20260507-001"
  warehouse_id    String?
  warehouse       Warehouse? @relation(fields: [warehouse_id], references: [id])
  location_id     String?              // Vị trí nhập (có thể thay đổi trước khi hoàn thành)
  location        Location?  @relation(fields: [location_id], references: [id])
  material_id     String?
  material        Material?  @relation(fields: [material_id], references: [id])
  planned_pallets Int?                 // Số pallet dự kiến (optional)
  shift_id        String?
  shift           ImportShift? @relation(fields: [shift_id], references: [id])
  status          String     @default("OPEN")
  // "OPEN" | "COMPLETED" | "CANCELLED"

  // Audit – người tạo, người sửa lần cuối
  imported_by     String?
  imported_by_emp Employee?  @relation("PIImportedBy", fields: [imported_by], references: [id])
  created_by      String?
  created_by_emp  Employee?  @relation("PICreatedBy", fields: [created_by], references: [id])
  updated_by      String?
  updated_by_emp  Employee?  @relation("PIUpdatedBy", fields: [updated_by], references: [id])

  import_date     DateTime   @default(now())
  notes           String?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  inventory_entries InventoryEntry[]

  @@index([warehouse_id])
  @@index([status])
  @@index([import_date])
  @@index([material_id])
}

// Lịch sử xuất kho – mỗi lần xuất tạo 1 record
model ExportHistory {
  id                 String          @id @default(uuid())
  inventory_entry_id String?
  inventory_entry    InventoryEntry? @relation(fields: [inventory_entry_id], references: [id])
  material_id        String?
  material           Material?       @relation(fields: [material_id], references: [id])
  exported_by        String?
  exported_by_emp    Employee?       @relation(fields: [exported_by], references: [id])
  delivery_order_id  String?
  delivery_order     DeliveryOrder?  @relation(fields: [delivery_order_id], references: [id])
  quantity           Int
  export_date        DateTime        @default(now())
  notes              String?
  created_at         DateTime        @default(now())

  @@index([inventory_entry_id])
  @@index([export_date])
}

// Lịch sử chuyển vị trí pallet
model LocationTransfer {
  id                 String         @id @default(uuid())
  inventory_entry_id String
  inventory_entry    InventoryEntry @relation(fields: [inventory_entry_id], references: [id])
  from_location_id   String?
  to_location_id     String?
  transferred_by     String?
  transferred_by_emp Employee?      @relation(fields: [transferred_by], references: [id])
  transfer_date      DateTime       @default(now())
  notes              String?
  created_at         DateTime       @default(now())

  @@index([inventory_entry_id])
}

// ============================================================
// TMS – QUẢN LÝ VẬN CHUYỂN
// ============================================================

model DeliveryOrder {
  id           String    @id @default(uuid())
  order_code   String?   @unique
  vehicle_id   String?
  vehicle      Vehicle?  @relation(fields: [vehicle_id], references: [id])
  driver_id    String?
  // Tài xế thực tế cho chuyến này (có thể khác với default_driver của xe)
  driver       Driver?   @relation(fields: [driver_id], references: [id])
  origin       String?
  destination  String?
  status       String    @default("PENDING")
  // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  scheduled_at DateTime?
  completed_at DateTime?
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  export_history ExportHistory[]

  @@index([status])
  @@index([vehicle_id])
  @@index([scheduled_at])
}

// ============================================================
// HR – QUẢN LÝ NHÂN SỰ
// ============================================================

model Shift {
  id           String   @id @default(uuid())
  name         String            // "Ca sáng", "Ca chiều", "Ca tối"
  start_time   String            // "08:00"
  end_time     String            // "17:00"
  days_of_week String[]          // ["1","2","3","4","5"] – thứ trong tuần
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  schedules    Schedule[]
}

model Schedule {
  id          String   @id @default(uuid())
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])
  shift_id    String
  shift       Shift    @relation(fields: [shift_id], references: [id])
  date        DateTime @db.Date
  status      String   @default("SCHEDULED")
  // "SCHEDULED" | "CONFIRMED" | "ABSENT" | "LATE"
  check_in    String?  // "08:05" – giờ vào thực tế
  check_out   String?  // "17:10" – giờ ra thực tế
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([employee_id, date])
  @@index([date])
  @@index([employee_id])
}

model OvertimeRequest {
  id          String    @id @default(uuid())
  employee_id String
  employee    Employee  @relation(fields: [employee_id], references: [id])
  date        DateTime  @db.Date
  hours       Float
  reason      String?
  status      String    @default("PENDING")
  // "PENDING" | "APPROVED" | "REJECTED"
  approved_by String?
  approved_at DateTime?
  notes       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([employee_id])
  @@index([status])
  @@index([date])
}

model Attendance {
  id          String    @id @default(uuid())
  employee_id String
  employee    Employee  @relation(fields: [employee_id], references: [id])
  date        DateTime  @db.Date
  check_in    DateTime?
  check_out   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([employee_id, date])
  @@index([date])
}

// ============================================================
// SYSTEM
// ============================================================

// Phân quyền menu theo role
model Menu {
  id        String  @id @default(uuid())
  key       String  @unique
  label     String
  path      String?
  icon      String?
  parent_id String?
  parent    Menu?   @relation("MenuTree", fields: [parent_id], references: [id])
  children  Menu[]  @relation("MenuTree")
  roles     String  // Comma-separated: "ADMIN,WAREHOUSE_MANAGER"
  order     Int     @default(0)
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Cài đặt hệ thống dạng key-value
model Setting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  type       String?  // "string" | "number" | "boolean" | "json"
  label      String?
  updated_at DateTime @updatedAt
}
